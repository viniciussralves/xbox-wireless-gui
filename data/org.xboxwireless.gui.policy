<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Xbox Wireless GUI</vendor>
  <action id="com.github.xbox-wireless-gui.pairing">
    <description>Gerenciar pairing do Xbox Wireless Adapter</description>
    <message>Autenticação necessária para ativar/desativar o pairing do dongle.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
  <action id="com.github.xbox-wireless-gui.led">
    <description>Gerenciar LED do controle Xbox</description>
    <message>Autenticação necessária para alterar modo/brilho do LED.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
